{
  "compilerOptions": {
    "target": "ES2020", "module": "ES2020", "moduleResolution": "bundler", "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true, "noImplicitReturns": true, "noFallthroughCasesInSwitch": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "forceConsistentCasingInFileNames": true,
    "outDir": "app/js", "rootDir": "src", "sourceMap": false, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
